# Copy to .env and fill in. .env is gitignored — never commit real secrets.
NAVIGA_CLIENT_ID=<your-naviga-client-id>
NAVIGA_CLIENT_SECRET=your-naviga-client-secret-here
NAVIGA_WEBSITE_ID=187
# Pick any long random string; the LiveX flow sends it as the X-Api-Key header.
PROXY_API_KEY=change-me-to-a-long-random-string
PORT=8080
